# Variables de entorno - Backend
# Copia este archivo como `.env` en la carpeta backend y completa los valores.

# Puerto del servidor Express
PORT=3000

# Secreto para firmar tokens JWT (cámbialo por una cadena larga y segura)
JWT_SECRET=tu_clave_secreta_super_segura

# Ruta/URL de la base de datos SQLite
DATABASE_URL=./database.sqlite

# CORS - orígenes permitidos (separados por coma si son varios)
CORS_ORIGINS=http://localhost:5173,http://192.168.100.25:5173
